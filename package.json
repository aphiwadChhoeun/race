{
  "name": "race",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
